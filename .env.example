# Port server
PORT=3000

# Masukkan Gemini API Key kamu di bawah ini:
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model Gemini yang digunakan (default: gemini-3.5-flash-lite)
# Opsi lain yang didukung @google/genai: gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
