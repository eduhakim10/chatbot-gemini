{
  "info": {
    "_postman_id": "hyundai-gemini-chatbot-api",
    "name": "Hyundai Summarecon Bekasi Chatbot API",
    "description": "Collection Postman resmi untuk Chatbot Dealer Hyundai Summarecon Bekasi berbasis Gemini AI Model. Dilengkapi endpoint multi-turn /api/chat, informasi dealer, dan health check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Kirim Chat (POST) - /api/chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation\": [\n    {\n      \"role\": \"user\",\n      \"text\": \"Di mana alamat dealer Hyundai Summarecon Bekasi dan jam buka bengkel resminya?\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Endpoint utama: Mengirim conversation array ke Gemini 1.5 Flash dan menerima respons profesional customer service Hyundai."
      },
      "response": []
    },
    {
      "name": "2. Tanya Mobil Listrik & Kona EV (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation\": [\n    {\n      \"role\": \"user\",\n      \"text\": \"Berapa estimasi harga Hyundai All New Kona Electric dan apa saja keunggulan baterainya?\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Konsultasi produk EV Hyundai Summarecon Bekasi."
      },
      "response": []
    },
    {
      "name": "3. Info Dealer Hyundai (GET) - /api/dealer-info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dealer-info",
          "host": ["{{baseUrl}}"],
          "path": ["api", "dealer-info"]
        },
        "description": "Mendapatkan profil resmi, alamat, jam kerja, nomor hotline, dan model populer Hyundai Summarecon Bekasi."
      },
      "response": []
    },
    {
      "name": "4. Health Check (GET) - /api/health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Mengecek status ketersediaan model dan service chatbot."
      },
      "response": []
    },
    {
      "name": "5. Single Text Generation (POST) - /generate-text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Explain why the sky is blue in simple terms.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/generate-text",
          "host": ["{{baseUrl}}"],
          "path": ["generate-text"]
        },
        "description": "Endpoint alternatif untuk pengujian single prompt generation."
      },
      "response": []
    }
  ]
}
