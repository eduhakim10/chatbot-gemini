# Port server
PORT=3000

# Masukkan Gemini API Key kamu di bawah ini:
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model Gemini yang digunakan (default: gemini-1.5-flash)
# Opsi lain: gemini-1.5-pro, gemini-2.0-flash, gemini-1.5-flash-8b
GEMINI_MODEL=gemini-1.5-flash
